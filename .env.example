# Gemini API (required for /api/brain and vision rerank)
GEMINI_API_KEY=
# Optional comma-separated Gemini keys for round-robin rotation & cooldown failover
GEMINI_API_KEYS=
# Optional default Gemini model override (e.g. gemini-3.5-flash-lite)
MOMO_MODEL=

# Hybrid Web & Image Search providers (recommended for live grounding)
TINYFISH_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=

# --- Running on your own machine instead of the Gemini API (optional) ---
# Which models the picker offers, in order (comma-separated ids from src/lib/modelCatalog.ts).
# Unset = the three Gemini API models above. Read at build time: rebuild after changing it.
#   router-gemini-3-flash, router-hermes, router-claude-sonnet   → an OpenAI-compatible router (9router)
#   claude-cli-sonnet, claude-cli-haiku                          → Claude Code run headless on this machine
#   gemini-cli                                                   → Gemini CLI run headless on this machine
NEXT_PUBLIC_MOMO_MODELS=
# OpenAI-compatible router base URL and key (key optional on loopback)
MOMO_ROUTER_URL=http://127.0.0.1:20128/v1
MOMO_ROUTER_KEY=
# CLI binaries, when they are not on PATH
MOMO_CLAUDE_CLI=
MOMO_GEMINI_CLI=

# --- Tools from an MCP server on this machine (optional) ---
# A stdio MCP server whose READ-ONLY tools (annotations.readOnlyHint) Momo may call next to web search.
# The server inherits this environment, so its own flags go here too. Only turn on a server's private
# data if everyone who can reach Momo may see it (see MOMO_PASSWORD below).
MOMO_MCP_COMMAND=
# Optional comma-separated allow-list of tool names (default: every read-only tool)
MOMO_MCP_TOOLS=

# --- Password login (optional) ---
# One shared password in front of every page and /api route (except /api/health and the login itself).
# Unset or empty = no login, exactly as before. Read at run time: restart after changing it.
MOMO_PASSWORD=
# HMAC key for the session cookie. Unset = derived from MOMO_PASSWORD, so changing the password signs
# everyone out; set it (e.g. `openssl rand -hex 32`) to rotate sessions independently of the password.
MOMO_SESSION_SECRET=

# --- Recording in FamHub from a chat, with confirmation (optional, off by default) ---
# The model may only propose a transaction or a recurring bill; a person confirms it on a card.
# On only when all three below AND MOMO_PASSWORD are set. Read at run time: restart after changing.
MOMO_FAMHUB_WRITE=
# FamHub's base URL, e.g. http://127.0.0.1:3110
MOMO_FAMHUB_URL=
# Name of the FamHub member Momo writes as; must be a parent (admin) in FamHub
MOMO_FAMHUB_MEMBER=
